<?xml version='1.0' encoding='utf-8'?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

  <!-- Include the robot macro -->
  <xacro:include filename="$(find franka_ros2_pixi)/config/fr3.urdf.xacro"/>

  <!-- Don't print a prefix for joints, visuals, and links? -->
  <xacro:arg name="no_prefix" default="false"/>

  <!-- Should the franka gripper be mounted at the flange? Default false:
       this robot uses the custom flange-key end-effector (see below). -->
  <xacro:arg name="load_gripper" default="false" />

  <!-- Which end-effector would be mounted at the flange?" -->
  <xacro:arg name="ee_id" default="franka_hand" />

  <!-- Should self-collision be enabled? -->
  <xacro:arg name="with_sc" default="false" />

  <!-- IP address or hostname of the robot" -->
  <xacro:arg name="robot_ip" default="172.16.0.2" />

  <!-- Should a fake hardware be used? -->
  <xacro:arg name="use_fake_hardware" default="false" />

  <!-- Should fake sensors be used? -->
  <xacro:arg name="fake_sensor_commands" default="false" />

  <!-- Should the robot be spawned in Gazebo?" -->
  <xacro:arg name="gazebo" default="false" />

  <!-- Should the robot be spawned in Gazebo with effort interfaces?" -->
  <xacro:arg name="gazebo_effort" default="true" />

  <!-- Prefix for the arm -->
  <xacro:arg name="arm_prefix" default="" />

  <xacro:arg name="has_camera" default="false" />

<xacro:property name="arm_prefix_modified" value="${'' if xacro.arg('arm_prefix') == '' else xacro.arg('arm_prefix') + '_'}" />

  <!-- Use the macro to create a single arm -->
  <xacro:fr3
    arm_id="fr3"
    robot_ip="$(arg robot_ip)"
    use_fake_hardware="$(arg use_fake_hardware)"
    arm_prefix="$(arg arm_prefix)"
    hand="$(arg load_gripper)"
  />

  <!-- Custom flange-key end-effector (added when the franka gripper is NOT loaded).
       Mirrors the MJCF 'hand' body in config/fr3.xml exactly so the CRISP controller's
       Pinocchio model matches what MuJoCo simulates:
         - mounted at the flange (fr3_link7 + 0.107 z) with the -45 deg key rotation
         - mass 0.2 kg, CoM 0.05 m out along the key
         - fr3_flange_key_tcp at the key tip (+0.103 z) = MJCF hand_tcp
       Set end_effector_frame: fr3_flange_key_tcp in controllers.yaml. -->
  <xacro:unless value="$(arg load_gripper)">
    <link name="fr3_flange_key">
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="5e-5"/>
      </inertial>
      <!-- Same STL + mm->m scale as the MJCF geom; link frame == MJCF hand frame,
           so the mesh sits at identity here. -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://franka_ros2_pixi/config/assets/fr3_flange_key_v0.9.0.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="fr3_flange_key_black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://franka_ros2_pixi/config/assets/fr3_flange_key_v0.9.0.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
    <joint name="fr3_flange_key_joint" type="fixed">
      <origin xyz="0 0 0.107" rpy="0 0 -0.785398163397"/>
      <parent link="fr3_link7"/>
      <child link="fr3_flange_key"/>
    </joint>
    <link name="fr3_flange_key_tcp"/>
    <joint name="fr3_flange_key_tcp_joint" type="fixed">
      <origin xyz="0 0 0.103" rpy="0 0 0"/>
      <parent link="fr3_flange_key"/>
      <child link="fr3_flange_key_tcp"/>
    </joint>
  </xacro:unless>

</robot>

