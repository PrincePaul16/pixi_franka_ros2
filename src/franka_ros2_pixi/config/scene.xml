<mujoco model="fr3 scene">
  <include file="fr3.xml"/>

  <option gravity="0 0 0" integrator="implicit" timestep="0.002"/>

  <!-- <statistic center="0.2 0 0.4" extent=".8"/> -->

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="vention">
      <geom conaffinity="0" contype="0" group="1"/>
      <default class="vention_collision">
        <geom conaffinity="1" condim="3" contype="0" group="4" margin="0.001" rgba=".4 .5 .6 1"
              solref="0.005 1" solimp="0.99 0.999 0.0005 0.5 2"/>
      </default>
    </default>

    <default class="tangram">
      <joint armature="1" damping="1"/>
      <geom contype="1" conaffinity="1" friction="1 0.1 0.1"/>
    </default>
    <default class="tangram_visual">
      <geom contype="0" conaffinity="0" group="2" mass="0"/>   <!-- visual only; collision parts carry the mass -->
    </default>
    <default class="tangram_collision">
      <geom contype="1" conaffinity="1" group="3" rgba="0.1 0.6 0.1 0.5"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Vention materials -->
    <material name="vention_white" rgba="1.0 1.0 1.0 1"  reflectance="1"  shininess=".1"/>
    <material name="vention_black" rgba="0.05 0.05 0.1 1" reflectance="1"  shininess=".5"/>
    <material name="vention_blue"  rgba=".14 .30 .52 1"  reflectance="10" shininess=".1"/>
    <material name="my_object" reflectance="1" shininess=".1"/>

